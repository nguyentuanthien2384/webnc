PORT=8000
DATABASE_URL=mongodb://127.0.0.1:27017/unishare
JWT_SECRET=your_jwt_secret_key_here
API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
# SMTP is required for self-service password recovery.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=UniShare <no-reply@example.com>
# SMTP_REQUIRE_TLS=true
# Set a unique password of at least 12 characters before running seed:admin.
# ADMIN_PASSWORD=
